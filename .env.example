# ─────────────────────────────────────────────────────────────
#  Todas as variáveis aqui são OPCIONAIS.
#  Sem nenhuma delas, o site abre o instalador em /instalar e você
#  informa os dados do MySQL pela tela.
# ─────────────────────────────────────────────────────────────

# URL pública do site (canonical, Open Graph, cookie seguro)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ── Pular o instalador ────────────────────────────────────────
# Se DB_HOST e DB_NAME existirem, o instalador é desativado e a
# conexão vem daqui. Útil depois que o site já está estável.
# DB_HOST=mysql.interno
# DB_PORT=3306
# DB_NAME=site
# DB_USER=site
# DB_PASS=
#
# Chave que assina o cookie de sessão. Se você usar as variáveis
# acima, defina esta também:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# APP_SECRET=

# ── Onde ficam os arquivos ────────────────────────────────────
# MEDIA_DIR=./media
# CONFIG_FILE=./data/config.json

# ── Desenvolver sem MySQL (opcional) ──────────────────────────
# npm i -D sqlite3
# DB_DIALECT=sqlite
# DB_HOST=local
# DB_NAME=site

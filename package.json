{
  "name": "site-pessoal",
  "version": "1.0.0",
  "description": "Site pessoal + CMS próprio (Next.js 16 + Sequelize + MySQL) — deploy Docker no Discloud",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 8080 -H 0.0.0.0",
    "lint": "next lint",
    "db:up": "docker compose up -d mysql",
    "db:down": "docker compose down",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrar.mjs up",
    "db:migrate:undo": "node --env-file-if-exists=.env scripts/migrar.mjs undo",
    "db:migrate:status": "node --env-file-if-exists=.env scripts/migrar.mjs status",
    "db:migrate:novo": "sequelize-cli migration:generate --name"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "marked": "^18.0.9",
    "mysql2": "^3.23.2",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sequelize": "^6.37.8",
    "sharp": "^0.34.2",
    "umzug": "^3.8.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "cross-env": "^7.0.3",
    "postcss": "^8.5.3",
    "sequelize-cli": "^6.6.5",
    "tailwindcss": "^4.3.3"
  }
}
